        "# this means that each (subject, observation) will be its own row taking 2 total columns, rather than a column for each subject\n",
        "# boxplot needs data in this format!\n",
        "df_plot = chart5_df.melt(value_vars=ai_help_cols, var_name='Subject', value_name='AI Usage Frequency')\n",
        "\n",
        "print(df_plot.head())\n",
        "\n",
        "df_plot['AI Usage Frequency'] = pd.to_numeric(\n",
        "    df_plot['AI Usage Frequency'].astype(str).str.extract(r'(\\d+\\.?\\d*)')[0],\n",
        "    errors='coerce'\n",
        ")\n",
        "\n",
        "# Replace the column names with reader friendly names\n",
        "df_plot['Subject'] = df_plot['Subject'].replace({\n",
        "    'AI_Help_Math': 'Math',\n",
        "    'AI_Help_Physics': 'Physics/Chemistry',\n",
        "    'AI_Help_CS': 'CS',\n",
        "    'AI_Help_DataSci': 'Data Science',\n",
        "    'AI_Help_SocSci': 'Social Sciences',\n",
        "    'AI_Help_Other': 'Other'\n",
        "})\n",
        "\n",
        "plt.figure(figsize=(12, 7))\n",
        "sns.boxplot(data=df_plot, x='Subject', y='AI Usage Frequency', palette=plt.cm.tab10(np.linspace(0, 1, len(ai_help_cols))))\n",
        "plt.title('Distribution of AI usage for learning across different subjects', size=16)\n",
        "plt.xlabel('Subject area', size=12)\n",
        "plt.ylabel('Usage frequency (Higher = More frequent)', size=12)\n",
        "plt.show()"
      ]
    },
