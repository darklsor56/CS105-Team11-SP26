   "source": [
    "import scipy.stats as stats # for kendalltau func + pvalue\n",
    "correlation, pvalue = stats.kendalltau(df['Ethical'], df['Verify_Likelihood'])\n",
    "print(f'Kendall Tau: {correlation}')\n",
    "print(f'P-value: {pvalue}')"
   ]
  },
